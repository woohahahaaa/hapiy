{
  "name": "opencode",
  "os_paths": {
    "windows": "%USERPROFILE%\\.config\\opencode\\opencode.json",
    "mac": "~/.config/opencode/opencode.json"
  },
  "json_paths": {
    "provider": "provider",
    "model": "provider.{provider_id}.models",
    "models_container": "object"
  },
  "recommendations": [
    {
      "scope": "provider",
      "key": "name",
      "description": "在 opencode 界面里的显示名（provider 名称）",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "npm",
      "description": "AI SDK 适配器包名（@ai-sdk/openai-compatible / @ai-sdk/openai / @ai-sdk/anthropic），一般由 endpoint 关键词自动归类",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "options.baseURL",
      "description": "API 端点（不填则走适配器默认）",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "options.apiKey",
      "description": "认证密钥",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "options.setCacheKey",
      "description": "启用 promptCacheKey 缓存优化（官方默认 false，建议开启）",
      "recommended": true,
      "required": false
    },
    {
      "scope": "model",
      "key": "name",
      "description": "模型在界面里的显示名",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "limit.context",
      "description": "上下文 token 上限",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "reasoning",
      "description": "模型是否支持思考模式（思考程度统一值→bool）",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "tool_call",
      "description": "模型是否支持工具调用",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "attachment",
      "description": "模型是否支持文件/图片附件输入",
      "recommended": null,
      "required": false
    }
  ],
  "protocols": [
    {
      "name": "OpenAI Responses API",
      "conditions": null,
      "endpoint_tags": [
        "responses"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "npm",
          "description": "Responses API 使用 OpenAI SDK",
          "recommended": "@ai-sdk/openai",
          "required": false
        }
      ]
    },
    {
      "name": "Anthropic Messages API",
      "conditions": null,
      "endpoint_tags": [
        "chat/message",
        "/v1/message",
        "messages"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "npm",
          "description": "Messages API 使用 Anthropic SDK",
          "recommended": "@ai-sdk/anthropic",
          "required": false
        },
        {
          "scope": "model",
          "key": "limit.output",
          "description": "输出 token 上限（anthropic-messages 协议必填，Anthropic 官方要求每请求带 max_tokens）",
          "recommended": null,
          "required": true
        }
      ]
    },
    {
      "name": "OpenAI 兼容 Chat Completions",
      "conditions": null,
      "endpoint_tags": [
        "completions",
        "chat/comple",
        "/v1/chat"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "npm",
          "description": "Chat Completions API 使用 OpenAI 兼容 SDK",
          "recommended": "@ai-sdk/openai-compatible",
          "required": false
        }
      ]
    }
  ],
  "model_info_fields": {
    "max_context": "limit.context",
    "max_output_token": "limit.output",
    "input_types": "modalities.input",
    "thinking_levels": {
      "path": "reasoning",
      "op": "bool"
    },
    "reasoning_effort": {
      "path": "options.reasoningEffort",
      "action": "skip",
      "op": "first",
      "values": ["medium"]
    }
  }
}