// ───────────────────────────────────────────────────────────────
// 默认推荐模板 JSONC —— ChatGPT
// 本文件是「ChatGPT」这个 Agent 的默认模板，交给别的 Agent 处理时请先读说明：
//
// name            规则名称（对应一个 Agent 软件类型，唯一）
// os_paths        该软件的配置文件默认路径（windows 支持 %USERPROFILE% 等；mac 支持 ~ / $HOME）
// json_paths      在配置文件里定位 provider / model 的 gjson 路径（这里留空=不使用 gjson 定位）
//   models_container  object=以模型名做键；array=数组每项带 id
// recommendations 公共配置：与请求协议 / SDK 无关的字段推荐值（弹窗里叫 common）
//   每行：key=字段路径(必填) / scope=provider|model / action=set|skip|delete
//         recommended=推荐值(null=推荐不填) / required=是否必填 / description=说明
//         op/sep/values=值写法（raw/bool/first/join；values 为允许值白名单）
// protocols       Endpoint 规则：按请求协议 / SDK 区分（null=无）
//   每块：name=规则名称(必填) / conditions=命中条件 / endpoint_tags=归纳范围关键词(必填，任一命中即应用)
//         recommendations=该 endpoint 的字段推荐表（行说明同上）
// model_info_fields  模型信息字段的写入方式（string 或 {path,op,sep,values,action}）
// ───────────────────────────────────────────────────────────────
{
  "name": "ChatGPT",
  "os_paths": {
    "windows": "%USERPROFILE%\\.codex\\config.toml",
    "mac": "~/.codex/config.toml"
  },
  "json_paths": {
    "provider": "",
    "model": "",
    "models_container": "object"
  },
  "recommendations": [
    {
      "scope": "provider",
      "key": "model_provider",
      "description": "顶层默认 provider id，取自 [model_providers] 的键（官方默认 openai）",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "name",
      "description": "自定义 provider 的显示名",
      "recommended": null,
      "required": false
    },
    {
      "scope": "provider",
      "key": "base_url",
      "description": "该 provider 的 API base URL（如 https://api.example.com/v1）",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "wire_api",
      "description": "接口协议（2026.02 起 Codex 强制 responses，不再支持 Chat Completions）",
      "recommended": "responses",
      "required": false
    },
    {
      "scope": "provider",
      "key": "env_key",
      "description": "提供 API key 的环境变量名（官方推荐用环境变量，不写明文 key）",
      "recommended": null,
      "required": false
    }
  ],
  "protocols": null,
  "model_info_fields": {
    "max_context": "",
    "max_output_token": "",
    "input_types": "",
    "thinking_levels": ""
  }
}