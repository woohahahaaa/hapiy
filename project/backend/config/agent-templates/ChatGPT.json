{
  "name": "ChatGPT",
  "os_paths": {
    "windows": "%USERPROFILE%\\.codex\\config.toml",
    "mac": "~/.codex/config.toml"
  },
  "json_paths": {
    "provider": "",
    "model": "",
    "models_container": "object"
  },
  "recommendations": [
    {
      "scope": "provider",
      "key": "model_provider",
      "description": "顶层默认 provider id，取自 [model_providers] 的键（官方默认 openai）",
      "type": "string",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "name",
      "description": "自定义 provider 的显示名",
      "type": "string",
      "recommended": null,
      "required": false
    },
    {
      "scope": "provider",
      "key": "base_url",
      "description": "该 provider 的 API base URL（如 https://api.example.com/v1）",
      "type": "string",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "env_key",
      "description": "提供 API key 的环境变量名（官方推荐用环境变量，不写明文 key）",
      "type": "string",
      "recommended": null,
      "required": false
    }
  ],
  "protocols": null,
  "model_info_fields": {
    "max_context": "",
    "max_output_token": "",
    "input_types": "",
    "thinking_levels": ""
  }
}