// ───────────────────────────────────────────────────────────────
// 默认推荐模板 JSONC —— opencode-v2
// 本文件是「opencode-v2」这个 Agent（新版 opencode，V2 结构）的默认模板：
//
// 与 opencode-v1 的关键差异（V2 配置结构）：
//   json_paths.provider   = "providers"（V2 顶层用复数键；V1 是单数 provider）
//   json_paths.model      = "providers.{provider_id}.models"
//   provider 驱动字段叫   package（V1 叫 npm）
//   端点/密钥写在         settings.*（V1 是 options.*）
//   reasoning 档位        variants 是 [{id,settings:{reasoningEffort}}] 数组
//                         （V1 是 {level:{options:{reasoningEffort}}} 对象）
//   reasoning_effort 白名单含 max（V1 只到 xhigh）
//
// name            规则名称（对应一个 Agent 软件类型，唯一）
// os_paths        该软件的配置文件默认路径（windows 支持 %USERPROFILE% 等；mac 支持 ~ / $HOME）
// json_paths      在配置文件里定位 provider / model 的 gjson 路径
//   provider      供应商列表路径
//   model         model 路径（用 {provider_id} 占位当前供应商键名）
//   models_container  object=以模型名做键；array=数组每项带 id
// recommendations 公共配置：与请求协议 / SDK 无关的字段推荐值（弹窗里叫 common）
//   每行：key=字段路径(必填) / scope=provider|model / action=set|skip|delete
//         recommended=推荐值(null=推荐不填) / required=是否必填 / description=说明
//         op/sep/values=值写法（raw/bool/first/join；values 为允许值白名单）
// protocols       Endpoint 规则：按请求协议 / SDK 区分
//   每块：name=规则名称(必填) / conditions=命中条件 / endpoint_tags=归纳范围关键词(必填，任一命中即应用)
//         recommendations=该 endpoint 的字段推荐表（行说明同上）
// model_info_fields  模型信息字段的写入方式（string 或 {path,op,sep,values,action}）
// ───────────────────────────────────────────────────────────────
{
  "name": "opencode-v2",
  "os_paths": {
    "windows": "%USERPROFILE%\\.config\\opencode\\opencode.json",
    "mac": "~/.config/opencode/opencode.json"
  },
  "json_paths": {
    "provider": "providers",
    "model": "providers.{provider_id}.models",
    "models_container": "object"
  },
  "recommendations": [
    {
      "scope": "provider",
      "key": "name",
      "description": "在 opencode 界面里的显示名（provider 名称）",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "package",
      "description": "AI SDK 适配器包名（@ai-sdk/openai-compatible / @ai-sdk/openai / @ai-sdk/anthropic），一般由 endpoint 关键词自动归类",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "settings.baseURL",
      "description": "API 端点（不填则走适配器默认）",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "settings.apiKey",
      "description": "认证密钥",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "settings.setCacheKey",
      "description": "启用 promptCacheKey 缓存优化（官方默认 false，建议开启）",
      "recommended": true,
      "required": false
    },
    {
      "scope": "model",
      "key": "name",
      "description": "模型在界面里的显示名",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "limit.context",
      "description": "上下文 token 上限",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "reasoning",
      "description": "模型是否支持思考模式（思考程度统一值→bool）",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "tool_call",
      "description": "模型是否支持工具调用",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "attachment",
      "description": "模型是否支持文件/图片附件输入",
      "recommended": null,
      "required": false
    }
  ],
  "protocols": [
    {
      "name": "OpenAI Responses API",
      "conditions": null,
      "endpoint_tags": [
        "responses"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "package",
          "description": "Responses API 使用 OpenAI SDK",
          "recommended": "@ai-sdk/openai",
          "required": false
        }
      ]
    },
    {
      "name": "Anthropic Messages API",
      "conditions": null,
      "endpoint_tags": [
        "chat/message",
        "/v1/message",
        "messages"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "package",
          "description": "Messages API 使用 Anthropic SDK",
          "recommended": "@ai-sdk/anthropic",
          "required": false
        },
        {
          "scope": "model",
          "key": "limit.output",
          "description": "输出 token 上限（anthropic-messages 协议必填，Anthropic 官方要求每请求带 max_tokens）",
          "recommended": null,
          "required": true
        }
      ]
    },
    {
      "name": "OpenAI 兼容 Chat Completions",
      "conditions": null,
      "endpoint_tags": [
        "completions",
        "chat/comple",
        "/v1/chat"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "package",
          "description": "Chat Completions API 使用 OpenAI 兼容 SDK",
          "recommended": "@ai-sdk/openai-compatible",
          "required": false
        }
      ]
    }
  ],
  "model_info_fields": {
    "max_context": "limit.context",
    "max_output_token": "limit.output",
    "input_types": "modalities.input",
    "thinking_levels": {
      "path": "reasoning",
      "op": "bool"
    },
    "reasoning_effort": {
      "path": "variants",
      "op": "variants",
      "values": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "variant_shape": "array"
    }
  }
}
