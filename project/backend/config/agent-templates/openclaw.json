// ───────────────────────────────────────────────────────────────
// 默认推荐模板 JSONC —— openclaw
// 本文件是「openclaw」这个 Agent 的默认模板，交给别的 Agent 处理时请先读说明：
//
// name            规则名称（对应一个 Agent 软件类型，唯一）
// os_paths        该软件的配置文件默认路径（windows 支持 %USERPROFILE% 等；mac 支持 ~ / $HOME）
// json_paths      在配置文件里定位 provider / model 的 gjson 路径
//   provider      供应商列表路径
//   model         model 路径（用 {provider_id} 占位当前供应商键名）
//   models_container  object=以模型名做键；array=数组每项带 id
// recommendations 公共配置：与请求协议 / SDK 无关的字段推荐值（弹窗里叫 common）
//   每行：key=字段路径(必填) / scope=provider|model / action=set|skip|delete
//         recommended=推荐值(null=推荐不填) / required=是否必填 / description=说明
//         op/sep/values=值写法（raw/bool/first/join；values 为允许值白名单）
// protocols       Endpoint 规则：按请求协议 / SDK 区分
//   每块：name=规则名称(必填) / conditions=命中条件 / endpoint_tags=归纳范围关键词(必填，任一命中即应用)
//         recommendations=该 endpoint 的字段推荐表（行说明同上）
// model_info_fields  模型信息字段的写入方式（string 或 {path,op,sep,values,action}）
// ───────────────────────────────────────────────────────────────
{
  "name": "openclaw",
  "os_paths": {
    "windows": "%USERPROFILE%\\.openclaw\\openclaw.json",
    "mac": "~/.openclaw/openclaw.json"
  },
  "json_paths": {
    "provider": "models.providers",
    "model": "models.providers.{provider_id}.models",
    "models_container": "array"
  },
  "recommendations": [
    {
      "scope": "provider",
      "key": "baseUrl",
      "description": "服务商 API 端点（按官方格式，注意不要多写不该有的 /v1）",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "apiKey",
      "description": "认证密钥。规范位置在 auth.profiles 段（用环境变量引用如 ${ZAI_API_KEY}），不在 models.providers 下内联",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "api",
      "description": "接口协议类型（openai-completions / anthropic-messages / ollama / lmstudio ...），一般由 endpoint 关键词自动归类",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "id",
      "description": "模型唯一标识",
      "recommended": null,
      "required": true
    },
    {
      "scope": "model",
      "key": "name",
      "description": "模型显示名",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "contextWindow",
      "description": "上下文 token 上限",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "input",
      "description": "支持的输入类型（text/image/video/audio）",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "reasoning",
      "description": "是否支持思考模式（官方 schema 校验，未配按 false 处理）",
      "recommended": null,
      "required": false
    }
  ],
  "protocols": [
    {
      "name": "Anthropic Messages API",
      "conditions": null,
      "endpoint_tags": [
        "chat/message",
        "/v1/message",
        "messages"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "api",
          "description": "Messages API 使用 anthropic-messages 协议",
          "recommended": "anthropic-messages",
          "required": false
        },
        {
          "scope": "model",
          "key": "maxTokens",
          "description": "输出 token 上限（anthropic-messages 协议必填，Anthropic 官方要求每请求带 max_tokens）",
          "recommended": null,
          "required": true
        }
      ]
    },
    {
      "name": "OpenAI 兼容 Chat Completions",
      "conditions": null,
      "endpoint_tags": [
        "completions",
        "chat/comple",
        "/v1/chat"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "api",
          "description": "Chat Completions API 使用 openai-completions 协议",
          "recommended": "openai-completions",
          "required": false
        }
      ]
    },
    {
      "name": "Ollama",
      "conditions": null,
      "endpoint_tags": [
        "ollama"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "api",
          "description": "Ollama 本地推理使用 ollama 协议",
          "recommended": "ollama",
          "required": false
        }
      ]
    },
    {
      "name": "LM Studio",
      "conditions": null,
      "endpoint_tags": [
        "lmstudio"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "api",
          "description": "LM Studio 本地推理使用 lmstudio 协议",
          "recommended": "lmstudio",
          "required": false
        }
      ]
    }
  ],
  "model_info_fields": {
    "max_context": "contextWindow",
    "max_output_token": "maxTokens",
    "input_types": {
      "path": "input",
      "values": ["text", "image", "video", "audio"]
    },
    "thinking_levels": {
      "path": "reasoning",
      "op": "bool"
    }
  }
}