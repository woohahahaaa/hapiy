{
  "name": "openclaw",
  "os_paths": {
    "windows": "%USERPROFILE%\\.openclaw\\openclaw.json",
    "mac": "~/.openclaw/openclaw.json"
  },
  "json_paths": {
    "provider": "models.providers",
    "model": "models.providers.{provider_id}.models",
    "models_container": "array"
  },
  "recommendations": [
    {
      "scope": "provider",
      "key": "baseUrl",
      "description": "服务商 API 端点（按官方格式，注意不要多写不该有的 /v1）",
      "type": "string",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "apiKey",
      "description": "认证密钥。规范位置在 auth.profiles 段（用环境变量引用如 ${ZAI_API_KEY}），不在 models.providers 下内联",
      "type": "string",
      "recommended": null,
      "required": true
    },
    {
      "scope": "provider",
      "key": "api",
      "description": "接口协议类型（openai-completions / anthropic-messages / ollama / lmstudio ...），一般由 endpoint 关键词自动归类",
      "type": "string",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "id",
      "description": "模型唯一标识",
      "type": "string",
      "recommended": null,
      "required": true
    },
    {
      "scope": "model",
      "key": "name",
      "description": "模型显示名",
      "type": "string",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "contextWindow",
      "description": "上下文 token 上限",
      "type": "number",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "input",
      "description": "支持的输入类型（text/image/video/audio）",
      "type": "array",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "reasoning",
      "description": "是否支持思考模式（官方 schema 校验，未配按 false 处理）",
      "type": "boolean",
      "recommended": null,
      "required": false
    }
  ],
  "protocols": [
    {
      "name": "Anthropic Messages API",
      "conditions": null,
      "endpoint_tags": [
        "chat/message",
        "/v1/message",
        "messages"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "api",
          "description": "Messages API 使用 anthropic-messages 协议",
          "type": "string",
          "recommended": "anthropic-messages",
          "required": false
        },
        {
          "scope": "model",
          "key": "maxTokens",
          "description": "输出 token 上限（anthropic-messages 协议必填，Anthropic 官方要求每请求带 max_tokens）",
          "type": "number",
          "recommended": null,
          "required": true
        }
      ]
    },
    {
      "name": "OpenAI 兼容 Chat Completions",
      "conditions": null,
      "endpoint_tags": [
        "completions",
        "chat/comple",
        "/v1/chat"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "api",
          "description": "Chat Completions API 使用 openai-completions 协议",
          "type": "string",
          "recommended": "openai-completions",
          "required": false
        }
      ]
    },
    {
      "name": "Ollama",
      "conditions": null,
      "endpoint_tags": [
        "ollama"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "api",
          "description": "Ollama 本地推理使用 ollama 协议",
          "type": "string",
          "recommended": "ollama",
          "required": false
        }
      ]
    },
    {
      "name": "LM Studio",
      "conditions": null,
      "endpoint_tags": [
        "lmstudio"
      ],
      "recommendations": [
        {
          "scope": "provider",
          "key": "api",
          "description": "LM Studio 本地推理使用 lmstudio 协议",
          "type": "string",
          "recommended": "lmstudio",
          "required": false
        }
      ]
    }
  ],
  "model_info_fields": {
    "max_context": "contextWindow",
    "max_output_token": "maxTokens",
    "input_types": {
      "path": "input",
      "values": ["text", "image", "video", "audio"]
    },
    "thinking_levels": {
      "path": "reasoning",
      "op": "bool"
    }
  }
}