{
  "name": "WorkBuddy",
  "os_paths": {
    "windows": "%USERPROFILE%\\.workbuddy\\models.json",
    "mac": "~/.workbuddy/models.json"
  },
  "json_paths": {
    "provider": "",
    "model": "",
    "models_container": "array"
  },
  "recommendations": [
    {
      "scope": "model",
      "key": "id",
      "description": "模型唯一标识（官方必填）",
      "type": "string",
      "recommended": null,
      "required": true
    },
    {
      "scope": "model",
      "key": "name",
      "description": "模型显示名称",
      "type": "string",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "apiKey",
      "description": "认证密钥（实际密钥值，非环境变量名；Ollama 本地填占位符 ollama）",
      "type": "string",
      "recommended": null,
      "required": true
    },
    {
      "scope": "model",
      "key": "url",
      "description": "API 端点，必须是完整路径且一般以 /chat/completions 结尾",
      "type": "string",
      "recommended": null,
      "required": true
    },
    {
      "scope": "model",
      "key": "maxInputTokens",
      "description": "最大输入 token 数",
      "type": "number",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "maxOutputTokens",
      "description": "最大输出 token 数",
      "type": "number",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "supportsToolCall",
      "description": "是否支持工具调用",
      "type": "boolean",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "supportsImages",
      "description": "是否支持图片输入（图片/视频等输入格式）",
      "type": "boolean",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "supportsReasoning",
      "description": "是否支持推理模式",
      "type": "boolean",
      "recommended": null,
      "required": false
    }
  ],
  "protocols": null,
  "model_info_fields": {
    "max_context": "maxInputTokens",
    "max_output_token": "maxOutputTokens",
    "input_types": {
      "path": "supportsImages",
      "op": "bool"
    },
    "thinking_levels": {
      "path": "supportsReasoning",
      "op": "bool"
    }
  }
}