// ───────────────────────────────────────────────────────────────
// 默认推荐模板 JSONC —— WorkBuddy
// 本文件是「WorkBuddy」这个 Agent 的默认模板，交给别的 Agent 处理时请先读说明：
//
// name            规则名称（对应一个 Agent 软件类型，唯一）
// os_paths        该软件的配置文件默认路径（windows 支持 %USERPROFILE% 等；mac 支持 ~ / $HOME）
// json_paths      在配置文件里定位 provider / model 的 gjson 路径（这里留空=不使用 gjson 定位）
//   models_container  object=以模型名做键；array=数组每项带 id
// recommendations 公共配置：与请求协议 / SDK 无关的字段推荐值（弹窗里叫 common）
//   每行：key=字段路径(必填) / scope=provider|model / action=set|skip|delete
//         recommended=推荐值(null=推荐不填) / required=是否必填 / description=说明
//         op/sep/values=值写法（raw/bool/first/join；values 为允许值白名单）
// protocols       Endpoint 规则：按请求协议 / SDK 区分（null=无）
//   每块：name=规则名称(必填) / conditions=命中条件 / endpoint_tags=归纳范围关键词(必填，任一命中即应用)
//         recommendations=该 endpoint 的字段推荐表（行说明同上）
// model_info_fields  模型信息字段的写入方式（string 或 {path,op,sep,values,action}）
// ───────────────────────────────────────────────────────────────
{
  "name": "WorkBuddy",
  "os_paths": {
    "windows": "%USERPROFILE%\\.workbuddy\\models.json",
    "mac": "~/.workbuddy/models.json"
  },
  "json_paths": {
    "provider": "",
    "model": "",
    "models_container": "array"
  },
  "recommendations": [
    {
      "scope": "model",
      "key": "id",
      "description": "模型唯一标识（官方必填）",
      "recommended": null,
      "required": true
    },
    {
      "scope": "model",
      "key": "name",
      "description": "模型显示名称",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "apiKey",
      "description": "认证密钥（实际密钥值，非环境变量名；Ollama 本地填占位符 ollama）",
      "recommended": null,
      "required": true
    },
    {
      "scope": "model",
      "key": "url",
      "description": "API 端点，必须是完整路径且一般以 /chat/completions 结尾",
      "recommended": null,
      "required": true
    },
    {
      "scope": "model",
      "key": "maxInputTokens",
      "description": "最大输入 token 数",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "maxOutputTokens",
      "description": "最大输出 token 数",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "supportsToolCall",
      "description": "是否支持工具调用",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "supportsImages",
      "description": "是否支持图片输入（图片/视频等输入格式）",
      "recommended": null,
      "required": false
    },
    {
      "scope": "model",
      "key": "supportsReasoning",
      "description": "是否支持推理模式",
      "recommended": null,
      "required": false
    }
  ],
  "protocols": null,
  "model_info_fields": {
    "max_context": "maxInputTokens",
    "max_output_token": "maxOutputTokens",
    "input_types": {
      "path": "supportsImages",
      "op": "bool"
    },
    "thinking_levels": {
      "path": "supportsReasoning",
      "op": "bool"
    }
  }
}