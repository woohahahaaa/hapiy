{
  "render": {
    "node": { "minWidth": 200, "maxWidth": 300 },
    "slot": { "padding": 16, "contentGap": 8 },
    "modelHub": { "paddingX": 12, "paddingY": 6 }
  },
  "layout": {
    "nodeGap": 80,
    "rowGap": 80,
    "modelHubGap": 20,
    "groupGap": 80,
    "marginX": 80,
    "marginY": 80
  },
  "fallbackNodeSize": { "width": 224, "height": 80 },
  "initialPositions": {
    "modelHub": { "x": 20, "y": 20, "verticalOffset": 60 },
    "provider": { "x": 450, "y": 20, "verticalOffset": 60 },
    "slot": { "x": 700, "y": 20, "horizontalOffset": 260, "verticalOffset": 60 }
  },
  "edge": { "animated": true, "strokeWidth": 1.5 },
  "grid": { "color": "var(--border)", "gap": 20, "size": 1 },
