    "provider": {
      "target": { "width": 12, "height": 20, "borderWidth": 2 },
      "source": { "width": 12, "height": 12, "borderWidth": 2 },
      "segmentGap": -2
    },
    "modelHub": {
      "source": { "width": 10, "height": 10, "borderWidth": 2 }
    },
    "slot": {
      "target": { "width": 8, "height": 8, "borderWidth": 2 },
      "source": { "width": 8, "height": 8, "borderWidth": 2 }
    }
  }
