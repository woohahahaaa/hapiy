{
  "dagre": {
    "direction": "LR",
    "nodeSeparation": 50,
    "rankSeparation": 80,
    "margin": { "x": 20, "y": 30 }
  },
  "nodeDimensions": {
    "modelHub": { "width": 224, "height": 200 },
    "channel": { "width": 192, "height": 100 },
    "autoReply": { "width": 192, "height": 120 },
    "requestModify": { "width": 192, "height": 120 },
    "responseModify": { "width": 192, "height": 120 },
    "logOutput": { "width": 192, "height": 220 },
    "autoSwitch": { "width": 192, "height": 140 },
    "concurrency": { "width": 192, "height": 100 },
    "slot": { "width": 220, "height": 180 }
  },
  "fallbackNodeDimension": { "width": 192, "height": 80 },
  "initialPositions": {
    "modelHub": { "x": 20, "y": 20, "verticalOffset": 60 },
    "channel": { "x": 450, "y": 20, "verticalOffset": 60 },
    "slot": { "x": 700, "y": 20, "horizontalOffset": 220, "verticalOffset": 60 }
  },
  "edge": { "animated": true, "strokeWidth": 1.5 },
  "grid": { "color": "var(--border)", "gap": 20, "size": 1 },
  "handles": {
    "channel": {
      "target": { "width": 12, "height": 20, "borderWidth": 2 },
      "source": { "width": 12, "height": 12, "borderWidth": 2 },
      "segmentGap": -2
    },
    "modelHub": {
      "source": { "width": 10, "height": 10, "borderWidth": 2 }
    },
    "slot": {
      "target": { "width": 8, "height": 8, "borderWidth": 2 },
      "source": { "width": 8, "height": 8, "borderWidth": 2 }
    }
  }
}
