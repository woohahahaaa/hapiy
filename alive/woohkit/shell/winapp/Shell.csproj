<Project Sdk="Microsoft.NET.Sdk">

  <!-- woohkit 通用 Windows 外壳：WinForms + 系统自带的 WebView2 运行时（随 Edge
       预装），只打开本机控制台。产物为 net48 的 WinExe，Win10/11 免装运行时。
       应用名/图标/Title 由 shell/winapp/build.sh 用 -p: 参数注入。 -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Shell</AssemblyName>
    <RootNamespace>KitShell</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
